# API service image. Multi-stage: build deps with uv, run with slim python.
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install uv for fast dependency resolution.
RUN pip install --no-cache-dir uv==0.5.5

# Copy dep metadata first to maximize Docker cache hits.
COPY pyproject.toml ./
RUN uv pip install --system --no-cache .

# Copy source last.
COPY agency_ads ./agency_ads
COPY alembic.ini ./alembic.ini
COPY alembic ./alembic

EXPOSE 8000

CMD ["uvicorn", "agency_ads.main:app", "--host", "0.0.0.0", "--port", "8000"]
