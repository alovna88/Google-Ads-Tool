# Copy to .env for local dev. Never commit .env.

# ----- Backend (app/api) -----
DATABASE_URL=postgresql+asyncpg://agency:agency@postgres:5432/agency
REDIS_URL=redis://redis:6379/0
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-32-byte-random-string
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google OAuth (staff login).
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials.
# Application type: Web application.
# Authorized redirect URI (dev): http://localhost:3000/api/auth/callback
# Authorized redirect URI (prod): https://<your-fly-app>/api/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Restrict staff login. Empty = allow any Google account in dev, deny all in prod.
# Use comma-separated values.
AUTH_ALLOWED_EMAIL_DOMAINS=
AUTH_ALLOWED_EMAILS=
AUTH_SESSION_MAX_AGE_HOURS=168

# Google Ads API — fill in once developer token is approved
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# LinkedIn Marketing API.
# Create an app at https://www.linkedin.com/developers/apps and add
# the "Advertising API" product (manual approval, days–weeks).
# Authorized redirect URL (dev): http://localhost:3000/api/linkedin/callback
# Authorized redirect URL (prod): https://<your-fly-app>/api/linkedin/callback
# Refresh tokens require the Marketing Developer Platform tier.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_SCOPES=r_ads,r_ads_reporting,r_basicprofile
LINKEDIN_API_VERSION=202405
LINKEDIN_REFRESH_SKEW_SECONDS=604800

# Static bearer token for the LinkedIn MCP server and other trusted
# local processes that need to read /linkedin/mcp/*. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Leave empty to disable that auth path entirely (recommended in prod
# unless the MCP runs on the same private network as the API).
AGENCY_SERVICE_TOKEN=

# Claude API
ANTHROPIC_API_KEY=

# ----- Frontend (app/web) -----
# In docker-compose this is set automatically. Override only if running
# the Next.js dev server outside Docker.
# API_INTERNAL_URL=http://api:8000
